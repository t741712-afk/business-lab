#!/bin/bash
# Frontal WordPress (Ubuntu 22.04): nginx + php-fpm + mariadb local + WordPress.
set -eux
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y nginx mariadb-server php-fpm php-mysql php-curl php-gd php-xml php-mbstring curl

systemctl enable --now mariadb

DBPASS="WpLab#2026"
WP_ADMIN="admin"
WP_ADMIN_PASS="WpAdmin#2026"
WP_TITLE="Business Lab WordPress"
WP_URL="http://10.0.0.32"

mysql -e "CREATE DATABASE IF NOT EXISTS wordpress;"
mysql -e "CREATE USER IF NOT EXISTS 'wp'@'localhost' IDENTIFIED BY '${DBPASS}';"
mysql -e "GRANT ALL ON wordpress.* TO 'wp'@'localhost'; FLUSH PRIVILEGES;"

# Descargar WordPress
cd /var/www
rm -rf /var/www/wordpress
curl -fsSL https://wordpress.org/latest.tar.gz | tar xz
cp -r wordpress/* /var/www/html/

cd /var/www/html
cp wp-config-sample.php wp-config.php
sed -i "s/database_name_here/wordpress/; s/username_here/wp/; s/password_here/${DBPASS}/" wp-config.php

chown -R www-data:www-data /var/www/html

PHPVER=$(ls /run/php/ | grep -oP 'php\K[0-9.]+' | head -1)

cat > /etc/nginx/sites-available/default <<EOF
server {
  listen 80 default_server;
  root /var/www/html;
  index index.php index.html;

  location / {
    try_files \$uri \$uri/ /index.php?\$args;
  }

  location ~ \.php\$ {
    include snippets/fastcgi-php.conf;
    fastcgi_pass unix:/run/php/php${PHPVER}-fpm.sock;
  }
}
EOF

systemctl enable --now php${PHPVER}-fpm nginx
systemctl restart nginx

# Instalar WP-CLI
curl -fsSL https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
  -o /usr/local/bin/wp
chmod +x /usr/local/bin/wp

# Instalar WordPress si todavía no está instalado
if ! sudo -u www-data wp core is-installed --path=/var/www/html; then
  sudo -u www-data wp core install \
    --path=/var/www/html \
    --url="${WP_URL}" \
    --title="${WP_TITLE}" \
    --admin_user="${WP_ADMIN}" \
    --admin_password="${WP_ADMIN_PASS}" \
    --admin_email="admin@business-lab.local"
fi

echo "wordpress ready" > /var/log/prov.done

# === CONFIGURACIÓN DE WORDPRESS PORTAL DE EMPLEO E INVESTIGACIÓN (TAI) ===

# 1. Configurar el título y descripción corporativa en la base de datos local usando sudo para mysql
sudo mysql -u root -p'root' -e "
USE wordpress; 
UPDATE wp_options SET option_value='TAI Insights | Science & Careers' WHERE option_name='blogname'; 
UPDATE wp_options SET option_value='Official research insights and technology career opportunities at Laboratories Corporation TAI.' WHERE option_name='blogdescription';
" 2>/dev/null

# 2. Localizar de forma dinámica la ruta del tema activo
WP_THEME_DIR=$(ls -d /var/www/html/wp-content/themes/*/ | head -n 1)

# 3. Inyectar la función PHP en functions.php (el método más robusto para temas de bloques modernos)
sudo tee -a "${WP_THEME_DIR}functions.php" > /dev/null << 'EOF'

function ctf_tai_corporate_theme() {
    echo "
    <style>
        /* --- TAI CORPORATE SYSTEM DESIGN --- */
        :root {
            --bg-dark: #0B0F19;
            --card-bg: #111827;
            --accent-blue: #3B82F6;
            --accent-cyan: #06B6D4;
            --text-main: #F3F4F6;
            --text-muted: #9CA3AF;
        }

        body, html, #page, .site, main, .wp-site-blocks, .site-content, .wp-block-post-template {
            background-color: var(--bg-dark) !important;
            color: var(--text-main) !important;
            font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
        }

        /* Títulos de posts y del portal */
        h1, h2, h3, h4, .site-title a, .wp-block-post-title a, .entry-title a {
            color: #FFFFFF !important;
            font-weight: 800 !important;
        }

        /* Transformar las entradas nativas de WordPress en tarjetas de ofertas de empleo / papers */
        article, .wp-block-post, .entry, .wp-block-group {
            background-color: var(--card-bg) !important;
            border: 1px solid #1F2937 !important;
            border-radius: 0.75rem !important;
            padding: 2.5rem !important;
            margin-bottom: 2rem !important;
            box-sizing: border-box !important;
        }

        .wp-block-post-excerpt p, .entry-content p {
            color: var(--text-muted) !important;
        }

        /* Enlaces y Navegación */
        a {
            color: var(--accent-cyan) !important;
            text-decoration: none !important;
        }

        a:hover {
            color: var(--accent-blue) !important;
        }

        .wp-block-navigation .wp-block-navigation-item__content {
            color: var(--text-muted) !important;
        }

        /* Elementos del Footer */
        footer, .site-footer {
            background-color: #030712 !important;
            border-top: 1px solid #1F2937 !important;
            padding: 3rem 2rem !important;
            color: var(--text-muted) !important;
        }
    </style>
    ";
}
add_action('wp_head', 'ctf_tai_corporate_theme', 999);
EOF

# 4. Corregido con SUDO para evitar el error "Operation not permitted"
sudo chown -R www-data:www-data /var/www/html/wp-content/themes/
