#!/bin/bash
# Despliegue de Blog Corporativo TAI con Panel de Publicación Web (Ubuntu 22.04)
set -Eeuo pipefail
set -x

export DEBIAN_FRONTEND=noninteractive

if [[ "${EUID}" -ne 0 ]]; then
    echo "Ejecuta este script como root: sudo bash $0" >&2
    exit 1
fi

# 1. Instalar paquetes necesarios
apt-get update -y
apt-get install -y nginx mariadb-server php-fpm php-mysql php-curl php-gd php-xml php-mbstring curl ca-certificates

systemctl enable --now mariadb

# Variables de configuración
DBNAME="tai_blog"
DBUSER="wp"
DBPASS="WpLab#2026"
WP_PATH="/var/www/html"

# 2. Configurar la Base de Datos e insertar datos iniciales
mysql -e "CREATE DATABASE IF NOT EXISTS ${DBNAME} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
mysql -e "CREATE USER IF NOT EXISTS '${DBUSER}'@'localhost' IDENTIFIED BY '${DBPASS}';"
mysql -e "ALTER USER '${DBUSER}'@'localhost' IDENTIFIED BY '${DBPASS}';"
mysql -e "GRANT ALL PRIVILEGES ON ${DBNAME}.* TO '${DBUSER}'@'localhost'; FLUSH PRIVILEGES;"

mysql "${DBNAME}" <<SQL
CREATE TABLE IF NOT EXISTS posts (
    id INT AUTO_INCREMENT PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    excerpt TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

INSERT INTO posts (title, excerpt, content) VALUES 
('TAI Insights | Science & Careers', 
 'Official research insights and technology career opportunities at Laboratories Corporation TAI.', 
 'Welcome to the official TAI Laboratories platform. Here we explore quantum computing, biotech advancements, and high-performance computing careers.'),
('Next-Gen Quantum Cryptography', 
 'Exploring our latest breakthroughs in secure communication protocols.', 
 'Our research team has successfully deployed a new layer of quantum-resistant encryption across our core laboratory infrastructure.');
SQL

# 3. Detectar la versión de PHP-FPM instalada
PHP_FPM_SERVICE="$(systemctl list-unit-files 'php*-fpm.service' --no-legend | awk '\$1 ~ /^php[0-9.]+-fpm\.service$/ {print \$1; exit}')"
if [[ -z "$PHP_FPM_SERVICE" ]]; then
    echo "No se ha encontrado un servicio PHP-FPM instalado." >&2
    exit 1
fi

PHPVER="${PHP_FPM_SERVICE#php}"
PHPVER="${PHPVER%-fpm.service}"
PHP_SOCKET="/run/php/php${PHPVER}-fpm.sock"

systemctl enable --now "$PHP_FPM_SERVICE"

# Esperar a que el socket de PHP-FPM esté disponible
for _ in $(seq 1 30); do
    [[ -S "$PHP_SOCKET" ]] && break
    sleep 1
done

if [[ ! -S "$PHP_SOCKET" ]]; then
    echo "No se encuentra el socket PHP-FPM: ${PHP_SOCKET}" >&2
    exit 1
fi

# 4. Configurar Nginx
cat > /etc/nginx/sites-available/default <<NGINX
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    root ${WP_PATH};
    index index.html index.php;

    location / {
        try_files \$uri \$uri/ /index.php?\$args;
    }

    location ~ \.php\$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:${PHP_SOCKET};
    }

    location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|ico|webp)\$ {
        expires 7d;
        access_log off;
    }

    location ~ /\. {
        deny all;
    }
}
NGINX

nginx -t
systemctl enable --now nginx
systemctl restart nginx

# 5. Crear el directorio web e instalar la aplicación
mkdir -p "$WP_PATH"

# Generar el API Backend en PHP con soporte para GET y POST seguro
cat > "${WP_PATH}/api.php" <<PHP
<?php
header("Content-Type: application/json; charset=UTF-8");
header("Access-Control-Allow-Origin: *");

\$host = 'localhost';
\$db   = '${DBNAME}';
\$user = '${DBUSER}';
\$pass = '${DBPASS}';
\$charset = 'utf8mb4';

\$dsn = "mysql:host=\$host;dbname=\$db;charset=\$charset";
\$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES   => false,
];

try {
     \$pdo = new PDO(\$dsn, \$user, \$pass, \$options);
} catch (\PDOException \$e) {
     echo json_encode(["error" => "Database connection failed"]);
     exit;
}

\$method = \$_SERVER['REQUEST_METHOD'];

if (\$method === 'GET') {
    \$stmt = \$pdo->query('SELECT id, title, excerpt, content, created_at FROM posts ORDER BY created_at DESC');
    \$posts = \$stmt->fetchAll();
    echo json_encode(\$posts);
    exit;
}

if (\$method === 'POST') {
    // Recibir JSON del frontend
    \$input = json_decode(file_get_contents('php://input'), true);
    
    \$admin_pass = \$input['password'] ?? '';
    \$title = \$input['title'] ?? '';
    \$excerpt = \$input['excerpt'] ?? '';
    \$content = \$input['content'] ?? '';

    // Validación elemental de contraseña (Contraseña original del script)
    if (\$admin_pass !== 'WpAdmin#2026') {
        http_response_code(401);
        echo json_encode(["success" => false, "message" => "Unauthorized: Incorrect password"]);
        exit;
    }

    if (empty(\$title) || empty(\$excerpt) || empty(\$content)) {
        http_response_code(400);
        echo json_encode(["success" => false, "message" => "All fields are required"]);
        exit;
    }

    try {
        \$stmt = \$pdo->prepare('INSERT INTO posts (title, excerpt, content) VALUES (?, ?, ?)');
        \$stmt->execute([\$title, \$excerpt, \$content]);
        echo json_encode(["success" => true, "message" => "Post published successfully"]);
    } catch (\Exception \$e) {
        http_response_code(500);
        echo json_encode(["success" => false, "message" => "Database insert error"]);
    }
    exit;
}
PHP

# Generar el Frontend HTML con la estética TAI exacta y panel de publicación
cat > "${WP_PATH}/index.html" <<'HTML'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TAI Insights | Science & Careers</title>
    <style>
        :root {
            --bg-dark: #0B0F19;
            --card-bg: #111827;
            --accent-blue: #3B82F6;
            --accent-cyan: #06B6D4;
            --text-main: #F3F4F6;
            --text-muted: #9CA3AF;
        }
        html, body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        header {
            background-color: #030712;
            border-bottom: 1px solid #1F2937;
            padding: 1.5rem 2rem;
        }
        .nav-container {
            max-width: 800px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        h1.site-title {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 800;
            color: #FFFFFF;
        }
        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            margin-left: 1.5rem;
            font-size: 0.95rem;
            transition: color 0.2s;
        }
        .nav-links a:hover {
            color: var(--accent-cyan);
        }
        main {
            flex: 1;
            max-width: 800px;
            width: 100%;
            margin: 3rem auto;
            padding: 0 1rem;
            box-sizing: border-box;
        }
        .site-description {
            color: var(--text-muted);
            font-size: 1.1rem;
            margin-bottom: 3rem;
            line-height: 1.6;
        }
        article {
            background-color: var(--card-bg);
            border: 1px solid #1F2937;
            border-radius: 0.75rem;
            padding: 2rem;
            margin-bottom: 2rem;
            box-sizing: border-box;
        }
        h2.post-title {
            color: #FFFFFF;
            font-weight: 800;
            margin-top: 0;
            margin-bottom: 0.5rem;
            font-size: 1.75rem;
        }
        .post-date {
            font-size: 0.85rem;
            color: var(--accent-blue);
            margin-bottom: 1rem;
        }
        .post-content {
            color: var(--text-muted);
            line-height: 1.7;
        }
        a.read-more {
            color: var(--accent-cyan);
            text-decoration: none;
            display: inline-block;
            margin-top: 1rem;
            font-weight: 600;
        }
        a.read-more:hover {
            color: var(--accent-blue);
        }
        
        /* Estilos del Formulario de Administración */
        .admin-panel {
            background-color: #030712;
            border: 1px dashed #1F2937;
            border-radius: 0.75rem;
            padding: 2rem;
            margin-top: 5rem;
        }
        .admin-panel h3 {
            color: #FFFFFF;
            margin-top: 0;
            margin-bottom: 1.5rem;
        }
        .form-group {
            margin-bottom: 1.25rem;
        }
        .form-group label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }
        .form-group input, .form-group textarea {
            width: 100%;
            background-color: var(--bg-dark);
            border: 1px solid #1F2937;
            border-radius: 0.375rem;
            padding: 0.75rem;
            color: #FFFFFF;
            font-family: inherit;
            box-sizing: border-box;
        }
        .form-group input:focus, .form-group textarea:focus {
            border-color: var(--accent-blue);
            outline: none;
        }
        button.btn-submit {
            background-color: var(--accent-blue);
            color: #FFFFFF;
            border: none;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            border-radius: 0.375rem;
            cursor: pointer;
            transition: background 0.2s;
        }
        button.btn-submit:hover {
            background-color: #2563EB;
        }
        .status-msg {
            margin-top: 1rem;
            font-size: 0.9rem;
            font-weight: 600;
        }

        footer {
            background-color: #030712;
            border-top: 1px solid #1F2937;
            padding: 3rem 2rem;
            color: var(--text-muted);
            text-align: center;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <header>
        <div class="nav-container">
            <h1 class="site-title">TAI Insights</h1>
            <nav class="nav-links">
                <a href="#">Science</a>
                <a href="#">Careers</a>
                <a href="#">Laboratories</a>
            </nav>
        </div>
    </header>
    <main>
        <div class="site-description">
            Official research insights and technology career opportunities at Laboratories Corporation TAI.
        </div>
        
        <section id="blog-posts">
            <p>Loading TAI insights...</p>
        </section>

        <section class="admin-panel">
            <h3>Publish New Research Insight</h3>
            <form id="publish-form">
                <div class="form-group">
                    <label for="post-password">Admin Password</label>
                    <input type="password" id="post-password" required placeholder="Enter WpAdmin#2026">
                </div>
                <div class="form-group">
                    <label for="post-title">Title</label>
                    <input type="text" id="post-title" required placeholder="e.g. Quantum Architecture Node 4">
                </div>
                <div class="form-group">
                    <label for="post-excerpt">Excerpt</label>
                    <input type="text" id="post-excerpt" required placeholder="Brief summary of the report">
                </div>
                <div class="form-group">
                    <label for="post-content">Full Content</label>
                    <textarea id="post-content" rows="6" required placeholder="Detailed analysis and research telemetry..."></textarea>
                </div>
                <button type="submit" class="btn-submit">Publish Update</button>
                <div id="status-message" class="status-msg"></div>
            </form>
        </section>
    </main>
    <footer>
        &copy; 2026 Laboratories Corporation TAI. All rights reserved.
    </footer>
    <script>
        async function fetchPosts() {
            const container = document.getElementById('blog-posts');
            try {
                const response = await fetch('api.php');
                if (!response.ok) throw new Error('Network error');
                const posts = await response.json();
                container.innerHTML = '';
                if (posts.length === 0) {
                    container.innerHTML = '<p>No insights published yet.</p>';
                    return;
                }
                posts.forEach(post => {
                    const article = document.createElement('article');
                    article.innerHTML = `
                        <h2 class="post-title">${post.title}</h2>
                        <div class="post-date">${new Date(post.created_at).toLocaleDateString()}</div>
                        <div class="post-content">
                            <p><strong>${post.excerpt}</strong></p>
                            <p>${post.content}</p>
                        </div>
                        <a href="#" class="read-more">Read full report &rarr;</a>
                    `;
                    container.appendChild(article);
                });
            } catch (error) {
                container.innerHTML = '<p style="color: var(--accent-cyan);">Error loading insights.</p>';
            }
        }

        document.getElementById('publish-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const statusMsg = document.getElementById('status-message');
            
            const payload = {
                password: document.getElementById('post-password').value,
                title: document.getElementById('post-title').value,
                excerpt: document.getElementById('post-excerpt').value,
                content: document.getElementById('post-content').value
            };

            try {
                const response = await fetch('api.php', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (response.ok) {
                    statusMsg.style.color = 'var(--accent-cyan)';
                    statusMsg.textContent = result.message;
                    document.getElementById('publish-form').reset();
                    fetchPosts();
                } else {
                    statusMsg.style.color = '#EF4444';
                    statusMsg.textContent = result.message || 'Verification failed.';
                }
            } catch (error) {
                statusMsg.style.color = '#EF4444';
                statusMsg.textContent = 'Network communication failure.';
            }
        });

        document.addEventListener('DOMContentLoaded', fetchPosts);
    </script>
</body>
</html>
HTML

# 6. Permisos finales
chown -R www-data:www-data "$WP_PATH"
nginx -t
systemctl reload nginx

echo "wordpress ready" > /var/log/prov.done
echo "Despliegue del Blog Corporativo Autónomo Completado."
